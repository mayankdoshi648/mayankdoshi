DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
PORT=3000

# Kotak Neo (preferred live quotes for Market Breadth overview)
# Consumer access token from Neo developer portal — enough for quotes (no full login).
# Preferred name:
KOTAK_NEO_CONSUMER_KEY=
# Also accepted: KOTAK_CONSUMER_KEY, NEO_CONSUMER_KEY, CONSUMER_KEY
# Optional trade session (TOTP + MPIN) — not required for index quotes
KOTAK_NEO_MOBILE=
KOTAK_NEO_UCC=
KOTAK_NEO_MPIN=
KOTAK_NEO_TOTP_SECRET=
# Or paste a one-shot TOTP instead of the secret:
# KOTAK_NEO_TOTP=

# DarvaX scanner & orders
DARVAX_AUTO_TRADE=false
DARVAX_RISK_PCT=1
DARVAX_CAPITAL=1000000
DARVAX_MIN_SCORE=70
DARVAX_STYLE=swing

# Obsidian second brain export (03-Watchlists/ in vault)
OBSIDIAN_VAULT_PATH=
OBSIDIAN_MIN_SCORE=55

# Telegram alerts (create bot via @BotFather, get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=85
TELEGRAM_BREAKOUT_MIN_SCORE=70

# Screener.in fundamentals enrichment (top N qualified NSE stocks per scan)
FUNDAMENTALS_MAX_FETCH=30
