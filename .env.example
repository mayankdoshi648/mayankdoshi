# Preferred: paste a ready-made Dhan access token (no PIN/TOTP needed).
# Generate from Dhan web → My Profile / API → Access Token (expires; paste a fresh one when needed).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional expiry ISO timestamp for the static token
# DHAN_ACCESS_TOKEN_EXPIRY=

# Alternative (Node only): auto-generate tokens via PIN + TOTP secret (Base32 from Dhan 2FA setup).
# Cloudflare Pages free deploy does NOT support PIN/TOTP minting — use Access Token there.
# Do NOT paste a 6-digit authenticator code into DHAN_TOTP_SECRET.
DHAN_PIN=
DHAN_TOTP_SECRET=
PORT=3000

# Production host helpers
# SESSION_SECRET=long-random-string
# ADMIN_SETUP_KEY=optional-key-required-to-change-creds-via-api
# FORCE_SECURE_COOKIES=1
# ALLOW_ENV_PERSIST=1

# Cloudflare Pages: set these in the dashboard (never commit real values)
# SESSION_SECRET=
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=

# Force synthetic equity Markets quotes (also auto-enabled when Dhan creds are missing)
DEMO_MODE=false

# Force labeled mock F&O data even when Dhan is configured (UI/dev)
# FNO_FORCE_MOCK=1

# DarvaX scanner & orders
DARVAX_AUTO_TRADE=false
DARVAX_RISK_PCT=1
DARVAX_CAPITAL=1000000
DARVAX_MIN_SCORE=70
DARVAX_STYLE=swing

# Obsidian second brain export (03-Watchlists/ in vault)
OBSIDIAN_VAULT_PATH=
OBSIDIAN_MIN_SCORE=55

# Telegram alerts (create bot via @BotFather, get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=85
TELEGRAM_BREAKOUT_MIN_SCORE=70

# Screener.in fundamentals enrichment (top N qualified NSE stocks per scan)
FUNDAMENTALS_MAX_FETCH=30
