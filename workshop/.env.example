# Copy to workshop/.env and fill in (never commit .env)

# --- Fyers (https://myapi.fyers.in/dashboard/) ---
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
# Optional: skip OAuth if you already have today's token
FYERS_ACCESS_TOKEN=

# --- Firstock (https://firstock.in/api/docs/login/) ---
FIRSTOCK_USER_ID=
FIRSTOCK_PASSWORD=
FIRSTOCK_VENDOR_CODE=
FIRSTOCK_API_KEY=
# TOTP from authenticator app (changes every 30s); or pass --totp on CLI
FIRSTOCK_TOTP=
